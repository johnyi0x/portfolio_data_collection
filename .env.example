# Neon — use the DIRECT connection string (host without -pooler, port 5432).
# This process stays online; the pooled URL is for the website later.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

